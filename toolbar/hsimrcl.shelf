<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="hsimrcl" label="HSimRCL">
    <memberTool name="hsimrcl_browser"/>
    <memberTool name="hsimrcl_simready_asset"/>
  </toolshelf>
  <tool name="hsimrcl_browser" label="SimReady Browser" icon="LOP_reference">
    <script scriptType="python"><![CDATA[import hou
# плавающее окно с Python Panel браузера; вкладку можно также добавить в любую панель (меню вкладок)
panel = hou.ui.curDesktop().createFloatingPanel(hou.paneTabType.PythonPanel, size=(1400, 850))
tab = panel.paneTabs()[0]
tab.setActiveInterface(hou.pypanel.interfaceByName("hsimrcl_browser"))
tab.showToolbar(False)
]]></script>
  </tool>
  <tool name="hsimrcl_simready_asset" label="SimReady Asset" icon="LOP_reference">
    <script scriptType="python"><![CDATA[import hou
import hsimrcl
stage = hou.node("/stage")
node = stage.createNode(hsimrcl.ASSET_TYPE)
node.setSelected(True, clear_all_selected=True)
]]></script>
  </tool>
</shelfDocument>
